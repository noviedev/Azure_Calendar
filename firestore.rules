rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Events / Bookings collection
    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // 2. Units & Unit Catalog collections
    match /units/{unitId} {
      allow read, write: if request.auth != null;
    }

    match /units_catalog/{catalogId} {
      allow read, write: if request.auth != null;
    }

    match /deleted_units/{deletedId} {
      allow read, write: if request.auth != null;
    }

    // 3. Agents & Profiles
    match /agents/{agentId} {
      allow read, write: if request.auth != null;
    }

    match /admin_profile/{profileId} {
      allow read, write: if request.auth != null;
    }

    // 4. Group Chats & Notifications
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    // 5. Default rule: Allow read and write only for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
